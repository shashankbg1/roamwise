# Copy to .env and adjust. All settings are optional; the defaults run with no keys.

# mock      = rule-based stand-in, free, no key needed (default)
# anthropic = Claude through the Anthropic API (set ANTHROPIC_API_KEY)
# bedrock   = Claude through AWS Bedrock (uses your AWS credentials)
ROAMWISE_LLM_PROVIDER=mock
ROAMWISE_LLM_MODEL=claude-opus-5-5
ROAMWISE_AWS_REGION=us-east-1

# ANTHROPIC_API_KEY=
